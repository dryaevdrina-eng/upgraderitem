name: Build mod

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.12

      # Если в репозиторий залит сам zip - распаковываем его.
      # Проект ищем в корне или в папке upgradecases.
      - name: Find project
        run: |
          if [ -f upgradecases.zip ]; then unzip -oq upgradecases.zip; fi
          if [ -f build.gradle ]; then echo "DIR=." >> $GITHUB_ENV; else echo "DIR=upgradecases" >> $GITHUB_ENV; fi

      - name: Build
        working-directory: ${{ env.DIR }}
        run: gradle build --no-daemon

      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: upgradecases-mod
          path: ${{ env.DIR }}/build/libs/*.jar
